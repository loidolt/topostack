{
  "name": "@topostack/map-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=/tmp/topostack-wrangler.log node --env-file-if-exists=../../.env ../../node_modules/wrangler/bin/wrangler.js dev --env development --port ${VITE_MAP_API_PORT:-8787}",
    "build": "WRANGLER_LOG_PATH=/tmp/topostack-wrangler.log wrangler deploy --dry-run --env=\"\" --outdir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "types": "WRANGLER_LOG_PATH=/tmp/topostack-wrangler.log wrangler types src/worker-configuration.d.ts --env-file .dev.vars.example",
    "types:check": "WRANGLER_LOG_PATH=/tmp/topostack-wrangler.log wrangler types src/worker-configuration.d.ts --env-file .dev.vars.example --check",
    "test": "WRANGLER_LOG_PATH=/tmp/topostack-wrangler-test.log vitest run test",
    "coverage": "WRANGLER_LOG_PATH=/tmp/topostack-wrangler-test.log vitest run test --coverage --coverage.provider=istanbul --coverage.reportsDirectory=coverage --coverage.thresholds.statements=80 --coverage.thresholds.branches=72 --coverage.thresholds.functions=95 --coverage.thresholds.lines=84"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260906.1"
  }
}
