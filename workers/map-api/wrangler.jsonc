{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "topostack-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../../apps/generator/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/ready", "/v1", "/v1/*"]
  },
  "vars": {
    "ENVIRONMENT": "development",
    "ALLOWED_ORIGINS": "http://localhost:5273,http://127.0.0.1:5273,https://dev-topostack.echofoxtrot.works,https://www.atomm.com",
    "ALLOWED_ORIGIN_SUFFIXES": ".atomm.com",
    "TERRAIN_ORIGIN": "https://s3.amazonaws.com/elevation-tiles-prod/terrarium",
    "GEOCODER_ORIGIN": "https://api.geoapify.com",
    "DATASET_VERSION": "mapzen-terrarium+protomaps-20260819-z12-v1"
  },
  // The top-level configuration is the fallback for a bare `wrangler deploy`
  // and for local tooling (tests, `--env=""` dry-run builds). It must never
  // point at production storage: bind the development buckets here so an
  // accidental bare deploy cannot write into production data.
  "r2_buckets": [
    { "binding": "MAP_CACHE", "bucket_name": "topostack-map-cache-development" },
    { "binding": "VECTOR_DATA", "bucket_name": "topostack-vector-data-development" }
  ],
  "ratelimits": [
    { "name": "REQUEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 240, "period": 60 } },
    { "name": "GEOCODE_LIMITER", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "env": {
    "development": {
      "name": "topostack-dev",
      "routes": [
        { "pattern": "dev-topostack.echofoxtrot.works", "custom_domain": true }
      ],
      "vars": {
        "ENVIRONMENT": "development",
        "ALLOWED_ORIGINS": "http://localhost:5273,http://127.0.0.1:5273,https://dev-topostack.echofoxtrot.works,https://www.atomm.com",
        "ALLOWED_ORIGIN_SUFFIXES": ".atomm.com",
        "TERRAIN_ORIGIN": "https://s3.amazonaws.com/elevation-tiles-prod/terrarium",
        "GEOCODER_ORIGIN": "https://api.geoapify.com",
        "DATASET_VERSION": "mapzen-terrarium+protomaps-20260819-z12-v1"
      },
      "r2_buckets": [
        { "binding": "MAP_CACHE", "bucket_name": "topostack-map-cache-development" },
        { "binding": "VECTOR_DATA", "bucket_name": "topostack-vector-data-development", "remote": true }
      ],
      "secrets": { "required": ["GEOCODER_API_KEY"] },
      "ratelimits": [
        { "name": "REQUEST_LIMITER", "namespace_id": "1002", "simple": { "limit": 240, "period": 60 } },
        { "name": "GEOCODE_LIMITER", "namespace_id": "1005", "simple": { "limit": 30, "period": 60 } }
      ]
    },
    "production": {
      "name": "topostack",
      "routes": [
        { "pattern": "topostack.echofoxtrot.works", "custom_domain": true }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "ALLOWED_ORIGINS": "https://topostack.echofoxtrot.works,https://www.atomm.com",
        "ALLOWED_ORIGIN_SUFFIXES": ".atomm.com",
        "TERRAIN_ORIGIN": "https://s3.amazonaws.com/elevation-tiles-prod/terrarium",
        "GEOCODER_ORIGIN": "https://api.geoapify.com",
        "DATASET_VERSION": "mapzen-terrarium+protomaps-20260819-z12-v1"
      },
      "r2_buckets": [
        { "binding": "MAP_CACHE", "bucket_name": "topostack-map-cache" },
        { "binding": "VECTOR_DATA", "bucket_name": "topostack-vector-data" }
      ],
      "secrets": { "required": ["GEOCODER_API_KEY"] },
      "ratelimits": [
        { "name": "REQUEST_LIMITER", "namespace_id": "1003", "simple": { "limit": 240, "period": 60 } },
        { "name": "GEOCODE_LIMITER", "namespace_id": "1006", "simple": { "limit": 30, "period": 60 } }
      ]
    }
  }
}
