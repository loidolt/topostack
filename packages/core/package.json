{
  "name": "@topostack/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "coverage": "vitest run src --coverage --coverage.reportsDirectory=coverage --coverage.thresholds.statements=88 --coverage.thresholds.branches=78 --coverage.thresholds.functions=92 --coverage.thresholds.lines=94"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "d3-contour": "^4.0.2",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@types/clipper-lib": "^6.4.0",
    "@types/d3-contour": "^3.0.6"
  }
}
